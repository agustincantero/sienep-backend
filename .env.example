# ── Base de datos ─────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:<puerto>/<nombre_bd>?currentSchema=proyecto
DB_USER=<usuario>
DB_PASSWORD=<contraseña>

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=<clave-secreta-larga-y-segura>

# ── Seed de usuarios de prueba (DataSeeder) ────────────────────────────────
# Crea admin@sienep.com / tutor@sienep.com / etc. con contraseñas hardcodeadas
# en el código. SOLO para dev/local. Default false si no se define — NUNCA
# poner en true en producción (crearía cuentas admin con contraseña conocida).
SEED_DEMO_USERS=true

# ── Mail (API HTTP de Brevo, no SMTP) ─────────────────────────────────────
# Se usa la API HTTP (no SMTP) porque varios proveedores (Render free tier
# incluido) bloquean tráfico saliente a puertos SMTP. Generar la API Key
# desde Brevo → Settings → API Keys (empieza con "xkeysib-", distinta de la
# clave SMTP "xsmtpsib-" que usaba la integración anterior).
BREVO_API_KEY=<api-key-de-brevo>

# ── Google Calendar Service Account ────────────────────────────────────────
# GOOGLE_CALENDAR_CREDENTIALS es el JSON COMPLETO de la service account, pegado
# tal cual como valor de la variable — NUNCA un archivo en el repo, ni siquiera
# de ejemplo con datos falsos. Se genera desde Google Cloud Console → IAM y
# administración → Cuentas de servicio → (crear) → Claves → Agregar clave (JSON).
# Requiere domain-wide delegation habilitada y el scope
# https://www.googleapis.com/auth/calendar.events autorizado en el admin console
# de Google Workspace para el Client ID de la service account.
# GOOGLE_CALENDAR_IMPERSONATE_ACCOUNT tiene que ser una cuenta DENTRO del mismo
# Workspace que autorizó la delegación (ej. sienep.app) — no una cuenta de un
# dominio externo (ej. utec.edu.uy). Los asistentes invitados a cada evento
# (EventAttendee) sí pueden ser de cualquier dominio, esa parte no tiene
# restricción.
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_CREDENTIALS=<json-completo-de-la-service-account>
GOOGLE_CALENDAR_CALENDAR_ID=<id-del-calendario-compartido>
GOOGLE_CALENDAR_IMPERSONATE_ACCOUNT=<cuenta>@tu-workspace.com
# Opcional: si no se define, usa "SIENEP".
GOOGLE_CALENDAR_APPLICATION_NAME=SIENEP

# ── Login con Google (OAuth 2.0) ───────────────────────────────────────────
# Client ID tipo "Web application", creado en Google Cloud Console → APIs y
# servicios → Credenciales → Crear credenciales → ID de cliente de OAuth.
# DISTINTO de la Service Account de arriba (esa es para Calendar). Se usa como
# audience esperado al verificar el ID token que el frontend obtiene vía
# Google Identity Services y manda a POST /auth/google. Solo autentica cuentas
# ya existentes (Funcionario/Estudiante por email) — no da de alta ninguna.
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com

# ── Almacenamiento de archivos subidos ────────────────────────────────────
# Carpeta base donde se guardan los archivos subidos (informes adjuntos en
# PDF/JPG/PNG y foto de perfil de estudiante en JPG/PNG, máx. 5MB c/u).
# Opcional: si no se define, usa "uploads" relativo al directorio de ejecución.
STORAGE_PATH=<ruta-absoluta-de-almacenamiento>

# ── Frontend ───────────────────────────────────────────────────────────────
# URL base del frontend, usada para armar el link de "olvidé mi contraseña"
# (ej. https://sienep.app/reset-password?token=...).
# Opcional: si no se define, usa http://localhost:3000 (default de Next.js).
FRONTEND_URL=<https://tu-frontend>

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Opcional: si no se define, permite http://localhost:3000 y https://sienep.app.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sienep.app