# ── Base de datos ─────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://<host>:<puerto>/<nombre_bd>?currentSchema=proyecto
DB_USER=<usuario>
DB_PASSWORD=<contraseña>

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=<clave-secreta-larga-y-segura>

# ── Mail (Brevo SMTP) ─────────────────────────────────────────────────────
MAIL_HOST=<smtp-host>
MAIL_PORT=<puerto>
MAIL_USERNAME=<usuario-brevo>
MAIL_PASSWORD=<clave-brevo>

# ── Google Calendar OAuth2 ────────────────────────────────────────────────
# Obtener desde Google Cloud Console → APIs y servicios → Credenciales
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
GOOGLE_REDIRECT_URI=<https://tu-dominio/api/auth/google/callback>

# ── Almacenamiento de archivos subidos ────────────────────────────────────
# Carpeta base donde se guardan los archivos subidos (informes adjuntos en
# PDF/JPG/PNG y foto de perfil de estudiante en JPG/PNG, máx. 5MB c/u).
# Opcional: si no se define, usa "uploads" relativo al directorio de ejecución.
STORAGE_PATH=<ruta-absoluta-de-almacenamiento>

# ── Frontend ───────────────────────────────────────────────────────────────
# URL base del frontend, usada para armar el link de "olvidé mi contraseña"
# (ej. https://sienep.app/restablecer-contrasenia?token=...).
# Opcional: si no se define, usa http://localhost:3000 (default de Next.js).
FRONTEND_URL=<https://tu-frontend>

# Orígenes permitidos para CORS, separados por coma (sin barra final).
# Opcional: si no se define, permite http://localhost:3000 y https://sienep.app.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://sienep.app